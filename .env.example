# SQLite DB location (automatically created)
HUDDLE_DB=./huddle.db
# Set to 1 when deployed behind HTTPS
SECURE_COOKIES=0
# Set to 1 ONLY for local demo (generates pre-filled demo conversations)
SEED_DEMO=0

# Optional: email OTP for NEW registrations. Both must be configured to activate.
# Obtain a free Brevo transactional email API key; verify the sending email first.
# Keep API keys in Railway Variables, NEVER GitHub or client-side JavaScript.
BREVO_API_KEY=
MAIL_FROM=

# Optional: AI tutoring chatbot. Free-tier API quotas may apply.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: image creation with Hugging Face Inference Providers credits.
# Kept disabled by default to avoid unexpected usage costs.
HF_TOKEN=
AI_IMAGES_ENABLED=0
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
